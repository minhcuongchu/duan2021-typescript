  "scripts": {
    "dev": "next dev -p 2021",
    "build": "next build",
    "start": "next start -p 2021",
    "type-check": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "lint": "eslint src/",
    "test": "jest",
    "test-all": "yarn lint && yarn type-check && yarn test"
  },
  "prepare": "husky",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "yarn run type-check"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint",
      "prettier --write"
    ]
  },
